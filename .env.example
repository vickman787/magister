# LLM for the Analyst agent (any OpenAI-compatible endpoint works)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Binance Agent OS MCP server.
# Execution happens inside your AI client (Codex/ChatGPT/etc.), which authenticates
# to Binance via OAuth when it connects. No Binance API keys are stored here.
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_MCP_TOKEN=

# Optional override for market-data REST host (default https://api.binance.com).
# If api.binance.com is unreachable from your network, point at a reachable
# market-data endpoint (e.g. https://data-api.binance.vision).
BINANCE_SPOT_BASE_URL=https://api.binance.com

# Where the append-only audit ledger is written
MAGISTER_DATA_DIR=
